# Database
DATABASE_URL=postgresql+asyncpg://trace:trace@localhost:5432/trace
DATABASE_URL_TEST=postgresql+asyncpg://trace:trace@localhost:5432/trace_test

# Security
SECRET_KEY=change-me-to-a-random-64-char-string
ENCRYPTION_KEY=change-me-to-a-random-32-char-string

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password recovery
PASSWORD_RESET_EXPIRE_MINUTES=30

# 2FA
TWO_FA_CHALLENGE_EXPIRE_MINUTES=5
TOTP_ISSUER=activia-trace

# Rate limiting (slowapi format: count/period)
LOGIN_RATE_LIMIT=5/60s

# Mail
MAILER_MODE=console

# Environment
ENVIRONMENT=development
LOG_LEVEL=DEBUG
